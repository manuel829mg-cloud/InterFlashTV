@@ -0,0 +1,49 @@
+package tv.own.owntv.interflash
+
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+
+class PanelSourceConfigTest {
+    @Test fun acceptsEmptyCatalogRevisionAndM3u() {
+        val config = PanelSourceConfig.parse(JSONObject("""{"revision":0,"kind":"m3u","url":"https://example.com/list.m3u"}"""))
+        assertEquals(0L, config.revision)
+        assertNull(config.username)
+    }
+    @Test fun acceptsXtreamCredentialsWithoutPuttingThemInUrl() {
+        val config = PanelSourceConfig.parse(JSONObject("""{"revision":4,"kind":"xtream","server":"https://example.com","username":"viewer","password":"secret"}"""))
+        assertEquals("viewer", config.username)
+        assertFalse(config.url.contains("secret"))
+    }
+    @Test fun acceptsHttpProviderAsSupportedByThePanel() {
+        val config = PanelSourceConfig.parse(JSONObject("""{"revision":2,"kind":"m3u","url":"http://example.com/list.m3u"}"""))
+        assertEquals("http://example.com/list.m3u", config.url)
+    }
+    @Test fun acceptsManualSourceAndItsIndependentRevision() {
+        val config = PanelSourceConfig.parse(JSONObject("""{"revision":5,"kind":"m3u","url":"https://example.com/list.m3u","manual_url":"https://interflash-isp-manager.up.railway.app/api/tv-native/manual/a/b.m3u","manual_revision":8}"""))
+        assertEquals(8L, config.manualRevision)
+        assertNotNull(config.manualUrl)
+    }
+    @Test fun absentManualSourceAllowsRemovalOfOldCatalog() {
+        val config = PanelSourceConfig.parse(JSONObject("""{"revision":6,"kind":"m3u","url":"https://example.com/list.m3u"}"""))
+        assertNull(config.manualUrl)
+    }
+    @Test fun rejectsManualSourceOutsidePanel() {
+        val result = runCatching { PanelSourceConfig.parse(JSONObject("""{"revision":5,"kind":"m3u","url":"https://example.com/list.m3u","manual_url":"https://example.com/manual.m3u"}""")) }
+        assertTrue(result.isFailure)
+    }
+    @Test fun rejectsInvalidOrUntrustedPayloads() {
+        val invalid = listOf(
+            """{"kind":"m3u","url":"https://example.com/list.m3u"}""",
+            """{"revision":-1,"kind":"m3u","url":"https://example.com/list.m3u"}""",
+            """{"revision":1,"kind":"m3u","url":"ftp://example.com/list.m3u"}""",
+            """{"revision":1,"kind":"m3u","url":"https://user:password@example.com/list.m3u"}""",
+            """{"revision":1,"kind":"stalker","url":"https://example.com"}""",
+            """{"revision":1,"kind":"xtream","server":"https://example.com","username":"viewer"}""",
+        )
+        invalid.forEachIndexed { index, payload ->
+            val result = runCatching { PanelSourceConfig.parse(JSONObject(payload)) }
+            assertTrue("Unsafe or incomplete payload $index must fail", result.isFailure)
+        }
+    }
+}
