--- /dev/null
+++ b/app/src/main/java/tv/own/owntv/interflash/CatalogFingerprint.kt
@@ -0,0 +1,14 @@
+package tv.own.owntv.interflash
+
+import java.security.MessageDigest
+
+/** Persist only a digest: source credentials must never be duplicated in preferences. */
+internal object CatalogFingerprint {
+    fun of(config: PanelSourceConfig): String {
+        val fields = listOf(config.revision.toString(), config.kind, config.url,
+            config.username, config.password, config.manualUrl, config.manualRevision.toString())
+        val encoded = fields.joinToString("") { if (it == null) "-1:" else "${it.length}:$it" }
+        return MessageDigest.getInstance("SHA-256").digest(encoded.toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it.toInt() and 255) }
+    }
+}
