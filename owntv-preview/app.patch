+++ b/app/src/test/java/tv/own/owntv/interflash/CatalogFingerprintTest.kt
@@ -0,0 +1,29 @@
+package tv.own.owntv.interflash
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class CatalogFingerprintTest {
+    private val config = PanelSourceConfig(1, "xtream", "https://example.com", "viewer", "secret", null, 1)
+
+    @Test fun stableAcrossRecreatedConfigurations() {
+        assertEquals(CatalogFingerprint.of(config), CatalogFingerprint.of(config.copy()))
+    }
+    @Test fun everyCatalogChangeInvalidatesSavedRevision() {
+        val original = CatalogFingerprint.of(config)
+        listOf(config.copy(revision = 2), config.copy(url = "https://other.example.com"),
+            config.copy(username = "other"), config.copy(password = "changed"),
+            config.copy(manualUrl = "https://example.com/manual.m3u"),
+            config.copy(manualRevision = 2), config.copy(kind = "m3u"))
+            .forEach { assertNotEquals(original, CatalogFingerprint.of(it)) }
+    }
+    @Test fun credentialsAreNotStoredAsPlainText() {
+        val digest = CatalogFingerprint.of(config)
+        assertTrue(digest.matches(Regex("[0-9a-f]{64}")))
+        assertFalse(digest.contains("secret"))
+    }
+    @Test fun fieldBoundariesCannotCollide() {
+        assertNotEquals(CatalogFingerprint.of(config.copy(username = "ab", password = "c")),
+            CatalogFingerprint.of(config.copy(username = "a", password = "bc")))
+    }
+}
