@@ -0,0 +1,232 @@
+package tv.own.owntv.interflash
+
+import android.content.Context
+import tv.own.owntv.R
+import androidx.compose.ui.res.stringResource
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.ui.platform.LocalContext
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import androidx.lifecycle.repeatOnLifecycle
+import androidx.tv.material3.Text
+import kotlinx.coroutines.*
+import kotlinx.coroutines.flow.first
+import org.json.JSONObject
+import org.koin.compose.koinInject
+import tv.own.owntv.core.database.dao.ProfileDao
+import tv.own.owntv.core.profile.ProfileManager
+import tv.own.owntv.core.repository.SourceRepository
+import tv.own.owntv.core.settings.SettingsRepository
+import tv.own.owntv.core.sync.SyncResult
+import tv.own.owntv.core.database.entity.SourceEntity
+import java.io.IOException
+import tv.own.owntv.features.settings.StageFullPage
+import tv.own.owntv.player.PlaybackEngines
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.SecureRandom
+
+/** Foreground-only panel authorization. No cached approval can admit a fresh launch. */
+@Composable
+fun InterFlashGate(content: @Composable () -> Unit) {
+    val context = LocalContext.current.applicationContext
+    val appName = stringResource(R.string.app_name)
+    val lifecycle = LocalLifecycleOwner.current.lifecycle
+    val sources: SourceRepository = koinInject()
+    val profiles: ProfileManager = koinInject()
+    val profileDao: ProfileDao = koinInject()
+    val settings: SettingsRepository = koinInject()
+    val engines: PlaybackEngines = koinInject()
+    val controller = remember(context) { PanelController(context, sources, profiles, profileDao, settings) }
+    var admitted by remember { mutableStateOf(false) }
+    var code by remember { mutableStateOf("") }
+    var message by remember { mutableStateOf(context.getString(R.string.interflash_connecting)) }
+
+    LaunchedEffect(controller, lifecycle) {
+        lifecycle.repeatOnLifecycle(Lifecycle.State.STARTED) {
+            admitted = false
+            while (isActive) {
+                try {
+                    val registration = withContext(Dispatchers.IO) { controller.register() }
+                    code = registration.optString("code")
+                    if (!registration.optBoolean("approved", false)) {
+                        admitted = false
+                        engines.onAppBackgrounded()
+                        message = context.getString(R.string.interflash_pair_instructions)
+                    } else {
+                        // Every poll rechecks config authorization, even if the revision is unchanged.
+                        controller.synchronize {
+                            if (!admitted) engines.onAppForegrounded()
+                            admitted = true
+                        }
+                        if (!admitted) engines.onAppForegrounded()
+                        admitted = true
+                    }
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (_: CatalogImportException) {
+                    // Authorization succeeded; a catalog refresh failure must keep the saved list open.
+                    message = context.getString(R.string.interflash_retry)
+                } catch (_: Exception) {
+                    // Fail closed on network/config errors; never leave a revoked session playing.
+                    admitted = false
+                    engines.onAppBackgrounded()
+                    message = context.getString(R.string.interflash_retry)
+                }
+                delay(10_000)
+            }
+        }
+    }
+    if (admitted) content() else {
+        StageFullPage(
+            parents = emptyList(), title = appName, count = stringResource(R.string.interflash_pair_title),
+            onBack = {}, handleBack = false, settingsRoot = false, modifier = Modifier.fillMaxSize(),
+        ) {
+            Text(if (code.isBlank()) stringResource(R.string.interflash_waiting_code) else stringResource(R.string.interflash_pair_code, code), color = tv.own.owntv.ui.theme.StageColors.Text)
+            Text(message, color = tv.own.owntv.ui.theme.StageColors.Text)
+        }
+    }
+}
+
+private class PanelController(
+    context: Context,
+    private val sources: SourceRepository,
+    private val profiles: ProfileManager,
+    private val profileDao: ProfileDao,
+    private val settings: SettingsRepository,
+) {
+    private val appName = context.getString(R.string.app_name)
+    private val manualName = context.getString(R.string.interflash_manual_channels)
+    private val prefs = context.getSharedPreferences("interflash_panel", Context.MODE_PRIVATE)
+    private val token: String = prefs.getString("device_token", null) ?: run {
+        val bytes = ByteArray(32).also { SecureRandom().nextBytes(it) }
+        bytes.joinToString("") { "%02x".format(it.toInt() and 255) }
+            .also { check(prefs.edit().putString("device_token", it).commit()) }
+    }
+    // In-memory fast path; the successful catalog fingerprint also survives process restarts.
+    private var importedConfig: PanelSourceConfig? = null
+
+    fun register(): JSONObject = request(
+        "/api/tv-native/register",
+        JSONObject().put("token", token).put("name", appName),
+    )
+
+    suspend fun synchronize(onCatalogReady: () -> Unit) {
+        val config = withContext(Dispatchers.IO) { request("/api/tv-native/config") }
+        val parsed = PanelSourceConfig.parse(config)
+        val allProfiles = profileDao.getAllOnce()
+        val activeProfile = settings.activeProfileId.first()
+        var profile = allProfiles.firstOrNull { it.id == activeProfile }?.id ?: allProfiles.firstOrNull()?.id
+        if (profile == null) {
+            profile = profiles.create(appName, 0, false, null, appName)
+        }
+        if (settings.activeProfileId.first() < 0) profiles.switchTo(profile)
+        val previousId = prefs.getLong("source_id", -1)
+        val previous = sources.getById(previousId)
+        val manualId = prefs.getLong("manual_source_id", -1)
+        val previousManual = sources.getById(manualId)
+        // Uploaded panel files already include manual channels; avoid importing them twice.
+        val bundledManual = parsed.kind == "m3u" && URL(parsed.url).let {
+            it.host == "interflash-isp-manager.up.railway.app" && it.path.startsWith("/api/tv-native/playlist/")
+        }
+        val manualUrl = parsed.manualUrl.takeUnless { bundledManual }
+        val cacheMatches = previous != null && previous.lastSyncAt != null &&
+            previous.url == parsed.url && previous.username == parsed.username &&
+            previous.password == parsed.password && previous.type.name.equals(parsed.kind, ignoreCase = true) &&
+            (manualUrl == null || (previousManual?.url == manualUrl && previousManual.lastSyncAt != null))
+        // Authorization was checked above on this foreground session. Only the catalog is cached.
+        if (cacheMatches) onCatalogReady()
+        val fingerprint = CatalogFingerprint.of(parsed)
+        if (cacheMatches && (importedConfig == parsed ||
+                prefs.getString("catalog_fingerprint", null) == fingerprint)) return
+
+        // Keep the same source id across refreshes so favourites remain attached.
+        val kind = parsed.kind
+        val url = parsed.url
+        val type = when (kind) {
+            "m3u" -> tv.own.owntv.core.model.SourceType.M3U
+            "xtream" -> tv.own.owntv.core.model.SourceType.XTREAM
+            else -> error("Unsupported panel source")
+        }
+        val source = if (previous == null) {
+            when (kind) {
+                "xtream" -> sources.addXtreamSource(profile, appName, url,
+                    requireNotNull(parsed.username), requireNotNull(parsed.password))
+                else -> sources.addM3uSource(profile, appName, url)
+            }.also { check(prefs.edit().putLong("source_id", it.id).commit()) }
+        } else previous.copy(
+            type = type, url = url,
+            username = parsed.username,
+            password = parsed.password,
+        ).also { sources.updateSource(it) }
+
+        // forcePrune is essential: removed channels must disappear, rather than stay cached.
+        importCatalog(source)
+        // A failed or cancelled import is retried; never acknowledge its revision prematurely.
+        if (manualUrl != null) {
+            val manualSource = if (previousManual == null) {
+                sources.addM3uSource(profile, manualName, manualUrl).also {
+                    check(prefs.edit().putLong("manual_source_id", it.id).commit())
+                }
+            } else previousManual.copy(url = manualUrl).also { sources.updateSource(it) }
+            importCatalog(manualSource)
+            // Show the newly added panel catalog alongside the existing provider on first import.
+            if (previousManual == null) settings.setDefaultSource(-1L)
+        } else if (previousManual != null) {
+            sources.deleteSource(previousManual)
+            check(prefs.edit().remove("manual_source_id").commit())
+        }
+        check(prefs.edit().putString("catalog_fingerprint", fingerprint).commit())
+        importedConfig = parsed
+    }
+
+    private suspend fun importCatalog(source: SourceEntity) {
+        val result = try {
+            sources.sync(source, forcePrune = true, onProgress = {})
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (error: Exception) {
+            throw CatalogImportException(error)
+        }
+        if (result !is SyncResult.Success) throw CatalogImportException()
+    }
+
+    private fun request(path: String, body: JSONObject? = null): JSONObject {
+        val connection = URL(PANEL_ROOT + path).openConnection() as HttpURLConnection
+        try {
+            connection.connectTimeout = 9_000
+            connection.readTimeout = 15_000
+            connection.instanceFollowRedirects = false
+            connection.setRequestProperty("Accept", "application/json")
+            if (body == null) connection.setRequestProperty("Authorization", "Bearer $token")
+            else {
+                connection.requestMethod = "POST"
+                connection.doOutput = true
+                connection.setRequestProperty("Content-Type", "application/json; charset=utf-8")
+                connection.outputStream.use { it.write(body.toString().toByteArray(Charsets.UTF_8)) }
+            }
+            check(connection.responseCode == 200) { "Panel request failed" }
+            val bytes = connection.inputStream.use { input ->
+                val output = java.io.ByteArrayOutputStream()
+                val buffer = ByteArray(8192)
+                while (true) {
+                    val count = input.read(buffer)
+                    if (count < 0) break
+                    check(output.size() + count <= 200_000) { "Panel response too large" }
+                    output.write(buffer, 0, count)
+                }
+                output.toByteArray()
+            }
+            return JSONObject(String(bytes, Charsets.UTF_8))
+        } finally {
+            connection.disconnect()
+        }
+    }
+    companion object {
+        private const val PANEL_ROOT = "https://interflash-isp-manager.up.railway.app"
+    }
+}
+
+private class CatalogImportException(cause: Throwable? = null) : IOException(cause)
diff --git a/app/src/main/java/tv/own/owntv/interflash/PanelSourceConfig.kt b/app/src/main/java/tv/own/owntv/interflash/PanelSourceConfig.kt
new file mode 100644
