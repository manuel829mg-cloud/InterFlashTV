+++ b/app/src/main/java/tv/own/owntv/interflash/PanelSourceConfig.kt
@@ -0,0 +1,45 @@
+package tv.own.owntv.interflash
+
+import org.json.JSONObject
+import java.net.URL
+
+/** Validate the authenticated panel payload before updating a stored source. */
+internal data class PanelSourceConfig(
+    val revision: Long,
+    val kind: String,
+    val url: String,
+    val username: String?,
+    val password: String?,
+    val manualUrl: String?,
+    val manualRevision: Long,
+) {
+    companion object {
+        fun parse(json: JSONObject): PanelSourceConfig {
+            val revision = json.getLong("revision")
+            require(revision >= 0) { "Invalid panel revision" }
+            val kind = json.getString("kind")
+            require(kind == "m3u" || kind == "xtream") { "Unsupported panel source" }
+            val raw = json.getString(if (kind == "xtream") "server" else "url")
+            val url = URL(raw)
+            require((url.protocol == "https" || url.protocol == "http") && url.host.isNotBlank() && url.userInfo == null) {
+                "The panel source must use HTTP(S) without inline credentials"
+            }
+            val manualUrl = json.optString("manual_url", "").takeIf { it.isNotBlank() }
+            manualUrl?.let {
+                val manual = URL(it)
+                require(manual.protocol == "https" && manual.host == "interflash-isp-manager.up.railway.app"
+                    && manual.userInfo == null && manual.path.startsWith("/api/tv-native/manual/")) {
+                    "Invalid manual channel source"
+                }
+            }
+            val manualRevision = json.optLong("manual_revision", revision)
+            require(manualRevision >= 0) { "Invalid manual revision" }
+            return PanelSourceConfig(
+                revision, kind, raw,
+                if (kind == "xtream") json.getString("username") else null,
+                if (kind == "xtream") json.getString("password") else null,
+                manualUrl, manualRevision,
+            )
+        }
+    }
+}
