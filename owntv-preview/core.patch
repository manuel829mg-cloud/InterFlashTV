@@ -0,0 +1,16 @@
+package tv.own.owntv.core.update
+
+import org.json.JSONArray
+
+/** Keep the TV updater on its own app and architecture when a release has several assets. */
+internal object ReleaseAssets {
+    fun compatibleUrl(assets: JSONArray, prefix: String, wantX86: Boolean): String? =
+        (0 until assets.length()).asSequence()
+            .mapNotNull { assets.optJSONObject(it) }
+            .mapNotNull { asset ->
+                val name = asset.optString("name")
+                val url = asset.optString("browser_download_url")
+                if (!name.startsWith(prefix) || !name.endsWith(".apk") || url.isBlank()) null
+                else url.takeIf { name.contains("x86_64", ignoreCase = true) == wantX86 }
+            }.firstOrNull()
+}
