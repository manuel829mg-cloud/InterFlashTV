@@ -0,0 +1,33 @@
+package tv.own.owntv.core.update
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+
+class ReleaseAssetsTest {
+    private fun asset(name: String, url: String = "https://example.com/$name") =
+        JSONObject().put("name", name).put("browser_download_url", url)
+    private val prefix = "InterFlashTV-OwnTV-"
+
+    @Test fun administrationApkCannotBeSelectedForTv() {
+        val assets = JSONArray().put(asset("InterFlash-admin.apk"))
+            .put(asset("InterFlashTV-OwnTV-v0.18-prueba.apk"))
+        assertEquals("https://example.com/InterFlashTV-OwnTV-v0.18-prueba.apk",
+            ReleaseAssets.compatibleUrl(assets, prefix, false))
+    }
+    @Test fun armAndEmulatorBuildsStaySeparate() {
+        val assets = JSONArray().put(asset("InterFlashTV-OwnTV-x86_64-v0.18.apk"))
+            .put(asset("InterFlashTV-OwnTV-v0.18-prueba.apk"))
+        assertTrue(ReleaseAssets.compatibleUrl(assets, prefix, true)!!.contains("x86_64"))
+        assertFalse(ReleaseAssets.compatibleUrl(assets, prefix, false)!!.contains("x86_64"))
+    }
+    @Test fun missingTvAssetDoesNotFallBackToAnotherApplication() {
+        assertNull(ReleaseAssets.compatibleUrl(JSONArray().put(asset("InterFlash-admin.apk")), prefix, false))
+    }
+    @Test fun sourceArchivesAndEmptyDownloadUrlsAreSkipped() {
+        val assets = JSONArray().put(asset("InterFlashTV-OwnTV-source.zip"))
+            .put(asset("InterFlashTV-OwnTV-v0.18.apk", ""))
+        assertNull(ReleaseAssets.compatibleUrl(assets, prefix, false))
+    }
+}
