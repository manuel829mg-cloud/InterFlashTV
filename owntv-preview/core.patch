@@ -0,0 +1,24 @@
+package tv.own.owntv.core.settings
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class InterFlashFastStartTest {
+    @Test fun startsEarlierWithoutShrinkingReserveOrRecovery() {
+        val control = LiveBuffer.loadControlFor(null, 0)
+        assertEquals(500, control.bufferForPlaybackMs)
+        assertEquals(8000, control.minBufferMs)
+        assertEquals(10000, control.maxBufferMs)
+        assertEquals(2000, control.bufferForPlaybackAfterRebufferMs)
+    }
+
+    @Test fun explicitPrerollIsRespected() {
+        for (seconds in listOf(2, 5, 10)) {
+            val control = LiveBuffer.loadControlFor(null, seconds)
+            assertEquals(seconds * 1000, control.bufferForPlaybackMs)
+            assertEquals(seconds * 1000, control.bufferForPlaybackAfterRebufferMs)
+            assertEquals(true, control.minBufferMs >= seconds * 1000)
+            assertEquals(2000, control.maxBufferMs - control.minBufferMs)
+        }
+    }
+}
