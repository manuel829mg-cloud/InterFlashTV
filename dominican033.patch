+/** Recognize provider labels with accents, flags or country prefixes. */
+private fun isDominicanFolder(name: String?): Boolean {
+    val normalized = java.text.Normalizer.normalize(name.orEmpty(), java.text.Normalizer.Form.NFD)
+        .replace(Regex("\\p{M}+"), "").lowercase(java.util.Locale.ROOT)
+    return normalized.contains("dominican")
+}
