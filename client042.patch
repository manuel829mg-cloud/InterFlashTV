+package tv.own.owntv.features.shell.components
+
+import androidx.compose.foundation.Canvas
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Path
+import androidx.compose.ui.graphics.StrokeCap
+import androidx.compose.ui.graphics.StrokeJoin
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.graphics.drawscope.scale
+import tv.own.owntv.ui.components.OwnTVIcon
+
+/** Lightweight cinema silhouettes: a clapperboard and stacked film frames. */
+@Composable
+internal fun CatalogueRailIcon(icon: OwnTVIcon, tint: Color, modifier: Modifier = Modifier) {
+    val outline = remember(icon) {
+        Path().apply {
+            if (icon == OwnTVIcon.MOVIES) {
+                moveTo(3f, 8f); lineTo(21f, 8f); lineTo(21f, 21f); lineTo(3f, 21f); close()
+                moveTo(3f, 8f); lineTo(2f, 4f); lineTo(20f, 1f); lineTo(21f, 5f); close()
+                moveTo(7f, 3.2f); lineTo(9f, 6.8f)
+                moveTo(13f, 2.2f); lineTo(15f, 5.8f)
+            } else {
+                moveTo(3f, 8f); lineTo(21f, 8f); lineTo(21f, 21f); lineTo(3f, 21f); close()
+                moveTo(5f, 5f); lineTo(19f, 5f)
+                moveTo(7f, 2f); lineTo(17f, 2f)
+                moveTo(6f, 8f); lineTo(6f, 21f)
+                moveTo(18f, 8f); lineTo(18f, 21f)
+                moveTo(3f, 14.5f); lineTo(6f, 14.5f)
+                moveTo(18f, 14.5f); lineTo(21f, 14.5f)
+            }
+        }
+    }
+    val play = remember { Path().apply { moveTo(10f, 11.5f); lineTo(15f, 14.5f); lineTo(10f, 17.5f); close() } }
+    Canvas(modifier) {
+        val factor = size.minDimension / 24f
+        scale(factor, factor, pivot = Offset.Zero) {
+            drawPath(outline, tint, style = Stroke(1.7f, cap = StrokeCap.Round, join = StrokeJoin.Round))
+            drawPath(play, tint)
+        }
+    }
+}
