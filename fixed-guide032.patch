+package tv.own.owntv.core.live
+
+import tv.own.owntv.core.database.entity.EpgProgrammeEntity
+
+/** Keep the next slot in the future, after the programme currently on air. */
+internal fun followingGuideProgramme(rows: List<EpgProgrammeEntity>, at: Long): EpgProgrammeEntity? {
+    val current = rows.filter { it.startMs <= at && it.stopMs > at }.maxByOrNull { it.startMs }
+    return rows.filter { it.startMs > at && it.startMs >= (current?.stopMs ?: at) }.minByOrNull { it.startMs }
+}
--- a/OwnTV_Core-main/core/src/main/java/tv/own/owntv/core/live/LiveEpgReader.kt
+++ b/OwnTV_Core-main/core/src/main/java/tv/own/owntv/core/live/LiveEpgReader.kt
@@ -322,6 +322,34 @@
      *
      * Deliberately never fetches. See the note in [nowPlayingFor] for what happened when it did.
      */
+    /** Batch next-programme lookup from stored guide/cache only; never fan out provider requests. */
+    suspend fun nextProgrammesFor(
+        channels: List<ChannelEntity>, cust: SectionCustomizations, globalShiftMinutes: Int,
+    ): Map<Long, XtEpgEntry> = withContext(Dispatchers.IO) {
+        val now = System.currentTimeMillis()
+        val keys = channels.mapNotNull { ch ->
+            val key = (cust.epgMatchResolver.epgIdFor(ch) ?: ch.epgChannelId)
+                ?.trim()?.lowercase()?.takeIf { it.isNotEmpty() }
+            key?.let { Triple(ch.id, it, EpgShift.minutesFor(cust, ch, globalShiftMinutes)) }
+        }
+        val result = HashMap<Long, XtEpgEntry>()
+        val priority = epgSourceStore.priority()
+        for ((shift, group) in keys.groupBy { it.third }) {
+            val at = EpgShift.toStored(now, shift)
+            val rows = group.map { it.second }.distinct().chunked(400).flatMap {
+                epgDao.programmeSummariesForChannels(it, at, at + 86_400_000L)
+            }.groupBy { it.epgChannelId }
+            for ((id, key, _) in group) {
+                val resolved = priority.resolve(rows[key].orEmpty())
+                val next = followingGuideProgramme(resolved, at)
+                if (next != null) result[id] = EpgShift.apply(next, shift).toXt()
+                else cache[id]?.takeIf { now - it.at < CACHE_TTL_MS }?.data?.next
+                    ?.takeIf { it.startMs > now }?.let { result[id] = it }
+            }
+        }
+        result
+    }
+
     private fun cachedNow(channelId: Long, now: Long): XtEpgEntry? {
         cache[channelId]?.takeIf { now - it.at < CACHE_TTL_MS }?.data?.now
             ?.takeIf { it.title.isNotBlank() }?.let { return it.copy(description = null) }
