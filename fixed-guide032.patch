+/** Permanent information only: never takes remote focus or controls playback. */
+@Composable
+fun InterFlashFixedGuide(channel: ChannelEntity?, guide: EpgNowNext?, modifier: Modifier = Modifier) {
+    if (channel == null) return
+    val unavailable = stringResource(R.string.interflash_no_guide)
+    Column(modifier.background(Color.Black.copy(alpha = 0.72f)).padding(horizontal = 24.dp, vertical = 8.dp)) {
+        Text(
+            channel.number?.let { stringResource(R.string.interflash_channel_identity, it.toString(), channel.name) } ?: channel.name,
+            color = Color.White, fontSize = 20.sp, maxLines = 1, overflow = TextOverflow.Ellipsis,
+        )
+        Text(
+            stringResource(R.string.interflash_guide_line, stringResource(R.string.content_live_now), guide?.now?.title ?: unavailable),
+            color = Color.White, fontSize = 17.sp, maxLines = 1, overflow = TextOverflow.Ellipsis,
+        )
+        Text(
+            stringResource(R.string.interflash_guide_line, stringResource(R.string.content_live_next), guide?.next?.title ?: unavailable),
+            color = Color.White, fontSize = 17.sp, maxLines = 1, overflow = TextOverflow.Ellipsis,
+        )
+    }
+}
