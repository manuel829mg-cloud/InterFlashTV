+package tv.own.owntv.core.live
+
+import org.junit.Assert.*
+import org.junit.Test
+import tv.own.owntv.core.database.entity.EpgProgrammeEntity
+
+class FollowingGuideProgrammeTest {
+    private fun p(start: Long, stop: Long) = EpgProgrammeEntity(sourceId = 1, epgChannelId = "test", startMs = start, stopMs = stop, title = "test")
+    @Test fun nextFollowsCurrentEvenWhenInputIsUnsorted() {
+        val current = p(100, 200); val next = p(200, 300)
+        assertEquals(next, followingGuideProgramme(listOf(p(300, 400), next, current), 150))
+    }
+    @Test fun overlapCannotBeAdvertisedAsNext() {
+        val next = p(200, 300)
+        assertEquals(next, followingGuideProgramme(listOf(p(100, 200), p(160, 180), next), 150))
+    }
+    @Test fun gapShowsEarliestFutureProgramme() {
+        val next = p(250, 300)
+        assertEquals(next, followingGuideProgramme(listOf(p(0, 100), next, p(300, 400)), 200))
+    }
+    @Test fun noFutureProgrammeReturnsNoInformation() {
+        assertNull(followingGuideProgramme(listOf(p(0, 100), p(100, 200)), 200))
+        assertNull(followingGuideProgramme(emptyList(), 200))
+    }
+}
