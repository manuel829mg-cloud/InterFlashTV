+package tv.own.owntv.interflash
+import org.junit.Assert.*
+import org.junit.Test
+class ModeHoldPressTest {
+    @Test fun requiresThreeSecondsAndFiresOnlyOnce() {
+        val press = ModeHoldPress()
+        assertTrue(press.start(100))
+        assertFalse(press.fireIfDue(3099))
+        assertTrue(press.fireIfDue(3100))
+        assertFalse(press.fireIfDue(6000))
+        assertEquals(ModeHoldPress.Release.NONE, press.release(6100))
+    }
+    @Test fun keyRepeatsDoNotRestartDeadline() {
+        val press = ModeHoldPress()
+        press.start(100)
+        assertFalse(press.start(2500))
+        assertTrue(press.fireIfDue(3100))
+    }
+    @Test fun earlyReleaseKeepsShortClickAndLateReleaseHandlesDelayedTimer() {
+        val press = ModeHoldPress()
+        press.start(100)
+        assertEquals(ModeHoldPress.Release.SHORT, press.release(3099))
+        press.start(4000)
+        assertEquals(ModeHoldPress.Release.LONG, press.release(7000))
+        assertEquals(ModeHoldPress.Release.NONE, press.release(7100))
+    }
+    @Test fun focusLossCancelsPendingAction() {
+        val press = ModeHoldPress()
+        press.start(100)
+        press.cancel()
+        assertFalse(press.fireIfDue(5000))
+        assertEquals(ModeHoldPress.Release.NONE, press.release(5100))
+        assertTrue(press.start(5200))
+    }
+}
