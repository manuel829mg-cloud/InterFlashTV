@@ -0,0 +1,28 @@
+package tv.own.owntv.interflash
+
+/** One action per remote hold, cancelled on focus loss. Uses monotonic milliseconds. */
+internal class ModeHoldPress {
+    companion object { const val HOLD_MS = 3_000L }
+    enum class Release { NONE, SHORT, LONG }
+    private var started: Long? = null
+    private var fired = false
+    fun start(now: Long): Boolean {
+        if (started != null) return false
+        started = now
+        fired = false
+        return true
+    }
+    fun fireIfDue(now: Long): Boolean {
+        val at = started ?: return false
+        if (fired || now - at < HOLD_MS) return false
+        fired = true
+        return true
+    }
+    fun release(now: Long): Release {
+        if (started == null) return Release.NONE
+        val result = if (fireIfDue(now)) Release.LONG else if (!fired) Release.SHORT else Release.NONE
+        cancel()
+        return result
+    }
+    fun cancel() { started = null; fired = false }
+}
