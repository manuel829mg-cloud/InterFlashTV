+package tv.own.owntv.interflash
+import org.junit.Assert.*
+import org.junit.Test
+class PanelGuideFallbackTest {
+    @Test fun workingGuideIsNeverReplaced() {
+        assertFalse(PanelGuideFallback.missing(" Existing.ID ", setOf("existing.id")))
+        assertTrue(PanelGuideFallback.missing(null, setOf("existing.id")))
+        assertTrue(PanelGuideFallback.missing("empty.id", setOf("existing.id")))
+    }
+    @Test fun explicitBroadcasterAliasesMatch() {
+        assertEquals("canal.2.de.república.dominicana.(teleantillas).do", PanelGuideFallback.idFor("RD | TELEANTILLAS CANAL 2 HD"))
+        assertEquals("canal.discovery.home.&.health.(república.dominicana).do", PanelGuideFallback.idFor("▸ Discovery H&H"))
+    }
+    @Test fun unaccentedPlaylistNamesMatchTheirBroadcaster() {
+        assertEquals("canal.9.de.color.visión.(república.dominicana).do", PanelGuideFallback.idFor("RD | COLOR VISION HD"))
+    }
+    @Test fun telemicroAndDigital15KeepTheirOwnSchedules() {
+        assertEquals("canal.5.de.república.dominicana.(telemicro).do", PanelGuideFallback.idFor("RD | TELEMICRO HD"))
+        assertEquals("canal.15.(digital.quince.telemicro).(república.dominicana).do", PanelGuideFallback.idFor("RD | DIGITAL 15"))
+        assertTrue(PanelGuideFallback.eligibleFolder("CINE LATINO HD"))
+    }
+    @Test fun distinctChannelsAndLoopChannelsAreNotInvented() {
+        assertNull(PanelGuideFallback.idFor("Telemicro Inter HD"))
+        assertNull(PanelGuideFallback.idFor("Cinemax East HD"))
+        assertNull(PanelGuideFallback.idFor("24/7 | Disney Channel"))
+        assertNull(PanelGuideFallback.idFor("Golden Edge HD"))
+        assertFalse(PanelGuideFallback.eligibleFolder("24/7 INFANTILES"))
+        assertFalse(PanelGuideFallback.eligibleFolder("ESTADOS UNIDOS"))
+        assertTrue(PanelGuideFallback.eligibleFolder("Canales Dominicanos"))
+    }
+}
