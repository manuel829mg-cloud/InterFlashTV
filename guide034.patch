+package tv.own.owntv.interflash
+
+import android.content.Context
+import androidx.work.ExistingWorkPolicy
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import tv.own.owntv.core.database.dao.ChannelDao
+import tv.own.owntv.core.epg.EpgSourceStore
+import tv.own.owntv.core.repository.EpgRepository
+import tv.own.owntv.core.repository.SourceRepository
+import tv.own.owntv.core.sync.work.EpgSyncScheduler
+import java.security.MessageDigest
+
+/** Register shared guides for every imported panel source, including manually added channels. */
+internal class PanelGuideSync(
+    context: Context,
+    private val sources: SourceRepository,
+    private val channels: ChannelDao,
+    private val guides: EpgSourceStore,
+    private val epg: EpgRepository,
+    private val scheduler: EpgSyncScheduler,
+    private val candidates: tv.own.owntv.core.epg.GuideCandidates,
+    private val customize: tv.own.owntv.core.customize.CustomizationStore,
+    private val settings: tv.own.owntv.core.settings.SettingsRepository,
+) {
+    private val prefs = context.getSharedPreferences("interflash_panel", Context.MODE_PRIVATE)
+
+    private var matchedStamp: String? = null
+
+    suspend fun check() = withContext(Dispatchers.IO) {
+        val urls = linkedMapOf<String, Pair<String, String?>>()
+        val sourceIds = mutableListOf<Long>()
+        for (key in listOf("source_id", "manual_source_id")) {
+            val source = sources.getById(prefs.getLong(key, -1)) ?: continue
+            sourceIds.add(source.id)
+            val advertised = epg.guideUrls(source)
+            advertised.forEach { urls[it] = source.name to source.userAgent }
+            if (advertised.isEmpty()) {
+                PanelGuideUrls.fromPlaylist(source.url)?.let { urls[it] = source.name to source.userAgent }
+                // Scan the full imported catalog; folder selection and numbering are left untouched.
+                channels.allForSources(listOf(source.id), Int.MAX_VALUE).forEach { channel ->
+                    PanelGuideUrls.fromStream(channel.streamUrl)?.let { urls[it] = source.name to source.userAgent }
+                }
+            }
+        }
+        for ((url, info) in urls) {
+            try {
+                val guide = guides.ensure(info.first, url, info.second)
+                val now = System.currentTimeMillis()
+                val key = "guide_attempt_" + MessageDigest.getInstance("SHA-256")
+                    .digest(url.toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it.toInt() and 255) }
+                val attempted = prefs.getLong(key, 0)
+                val synced = guide.lastSyncAt ?: 0
+                if ((synced == 0L || now - synced >= 6 * 60 * 60 * 1000L) &&
+                    (attempted == 0L || now - attempted >= 30 * 60 * 1000L)) {
+                    // KEEP avoids cancelling a guide already downloading. Initial fetch can run
+                    // while viewing, without blocking catalog authorization or playback startup.
+                    scheduler.enqueueSync(guide.id, "interflash-guide", policy = ExistingWorkPolicy.KEEP)
+                    prefs.edit().putLong(key, now).apply()
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                // Guide failure must not close the player or discard its last successful data.
+            }
+        }
+        // Fill missing IDs by exact, unambiguous channel names. Never guess a similar channel.
+        val profile = settings.activeProfileId.first()
+        val stamp = guides.getAll().joinToString { "${it.id}:${it.lastSyncAt}" } +
+            sourceIds.map { sources.getById(it)?.lastSyncAt }.toString() + profile
+        if (stamp == matchedStamp || profile < 0) return@withContext
+        val available = candidates.all()
+        if (available.isEmpty()) return@withContext
+        val byName = available.filter { !it.displayName.isNullOrBlank() }
+            .groupBy { tv.own.owntv.core.epg.EpgMatcher.normalizeForEpg(it.displayName!!) }
+        val withProgrammes = available.filter { it.hasProgrammes }
+            .mapTo(HashSet()) { it.epgChannelId.trim().lowercase() }
+        val type = tv.own.owntv.core.model.MediaType.LIVE
+        val cust = customize.observe(profile, type).first()
+        val additions = linkedMapOf<String, String>()
+        for (channel in channels.allForSources(sourceIds, Int.MAX_VALUE)) {
+            if (cust.epgMatchResolver.epgIdFor(channel) != null) continue
+            if (channel.epgChannelId?.trim()?.lowercase() in withProgrammes) continue
+            val name = tv.own.owntv.core.epg.EpgMatcher.normalizeForEpg(channel.name)
+            if (name.isBlank()) continue
+            val matches = byName[name].orEmpty().map { it.epgChannelId.trim().lowercase() }.distinct()
+            if (matches.size == 1) additions[tv.own.owntv.core.customize.CustomizeKeys.channel(channel)] = matches.single()
+        }
+        if (additions.isNotEmpty()) {
+            // Preserve any user override made while discovery was running.
+            customize.update(profile, type) { it.copy(epgMatches = additions + it.epgMatches) }
+            epg.storeProgrammesForIdsFromCache(additions.values.toSet())
+        }
+        matchedStamp = stamp
+    }
+}
