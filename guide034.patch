+package tv.own.owntv.interflash
+import org.junit.Assert.*
+import org.junit.Test
+class PanelGuideUrlsTest {
+    @Test fun playlistPreservesOriginAndEscapedCredentials() {
+        assertEquals("https://example.org:2082/sub/xmltv.php?username=a%2Bb&password=p%26s",
+            PanelGuideUrls.fromPlaylist("https://example.org:2082/sub/get.php?username=a%2Bb&password=p%26s&type=m3u_plus"))
+    }
+    @Test fun streamUsesProviderOrigin() {
+        assertEquals("http://example.org:2095/xmltv.php?username=a%2Bb&password=p%26s",
+            PanelGuideUrls.fromStream("http://example.org:2095/live/a+b/p%26s/123.ts"))
+    }
+    @Test fun doesNotGuessNonXtreamEndpoints() {
+        assertNull(PanelGuideUrls.fromPlaylist("https://example.org/panel/list.m3u"))
+        assertNull(PanelGuideUrls.fromStream("https://example.org/hls/live.m3u8"))
+        assertNull(PanelGuideUrls.fromStream("file:///live/user/pass/1.ts"))
+        assertNull(PanelGuideUrls.fromPlaylist("https://example.org/get.php?username=a"))
+    }
+}
