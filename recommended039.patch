+package tv.own.owntv.ui.format
+import org.junit.Assert.*
+import org.junit.Test
+import java.util.Date
+import java.util.TimeZone
+class DominicanTimeTest {
+    @Test fun ignoresDeviceZoneAndUsesTwelveHours() {
+        val old = TimeZone.getDefault()
+        try {
+            TimeZone.setDefault(TimeZone.getTimeZone("Asia/Tokyo"))
+            val format = DominicanTime.formatter()
+            assertEquals("America/Santo_Domingo", format.timeZone.id)
+            val instant = java.time.Instant.parse("2026-11-06T14:30:00Z").toEpochMilli()
+            assertTrue(format.format(Date(instant)).startsWith("10:30"))
+            val night = java.time.Instant.parse("2026-11-07T01:30:00Z").toEpochMilli()
+            assertTrue(format.format(Date(night)).startsWith("9:30"))
+            assertEquals("h:mm a", format.toPattern())
+        } finally { TimeZone.setDefault(old) }
+    }
+}
