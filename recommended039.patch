+package tv.own.owntv.core.settings
+import androidx.datastore.preferences.core.mutablePreferencesOf
+import org.junit.Assert.*
+import org.junit.Test
+class InterFlashRecommendedTest {
+    @Test fun freshInstallUsesRecommendedWithoutPreload() {
+        val p = mutablePreferencesOf()
+        SettingsRepository.interFlashRecommendedDefaults(p)
+        assertEquals(LiveLatency.DEFAULT.name, p[SettingsRepository.Keys.LIVE_LATENCY_MODE])
+        assertEquals(0, p[SettingsRepository.Keys.LIVE_PREROLL_SECS])
+        assertNull(LiveBuffer.effectiveSeconds(LiveLatency.fromName(p[SettingsRepository.Keys.LIVE_LATENCY_MODE]), 30))
+    }
+    @Test fun upgradesOldCustomOnceAndPreservesLaterChanges() {
+        val p = mutablePreferencesOf(SettingsRepository.Keys.LIVE_LATENCY_MODE to LiveLatency.CUSTOM.name, SettingsRepository.Keys.LIVE_PREROLL_SECS to 5, SettingsRepository.Keys.INTERFLASH_STABILITY_029 to true)
+        SettingsRepository.interFlashRecommendedDefaults(p)
+        assertEquals(LiveLatency.DEFAULT.name, p[SettingsRepository.Keys.LIVE_LATENCY_MODE])
+        p[SettingsRepository.Keys.LIVE_LATENCY_MODE] = LiveLatency.STABLE.name
+        p[SettingsRepository.Keys.LIVE_PREROLL_SECS] = 2
+        SettingsRepository.interFlashRecommendedDefaults(p)
+        assertEquals(LiveLatency.STABLE.name, p[SettingsRepository.Keys.LIVE_LATENCY_MODE])
+        assertEquals(2, p[SettingsRepository.Keys.LIVE_PREROLL_SECS])
+    }
+}
