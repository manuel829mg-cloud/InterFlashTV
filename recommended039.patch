+package tv.own.owntv.ui.format
+
+import java.text.SimpleDateFormat
+import java.util.Locale
+import java.util.TimeZone
+
+/** Each caller owns its formatter: SimpleDateFormat is mutable, never shared across threads. */
+internal object DominicanTime {
+    val zone: TimeZone get() = TimeZone.getTimeZone("America/Santo_Domingo")
+    val locale: Locale get() = Locale.forLanguageTag("es-DO")
+    fun formatter(): SimpleDateFormat = SimpleDateFormat("h:mm a", locale).apply { timeZone = zone }
+}
